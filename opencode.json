{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "plugin": [
    "oh-my-openagent@5.0.0-beta.90"
  ],
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 24576
  },
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 6000,
    "tail_turns": 3
  },
  "keybinds": {
    "input_paste": "ctrl+v"
  }
}
